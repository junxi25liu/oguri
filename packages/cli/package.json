{
  "name": "oguri",
  "version": "1.0.1",
  "description": "Talk to one agent. It runs every machine you own: superagents for Claude Code and Codex, over a Git repository you own.",
  "license": "MIT",
  "//mcpName": "Ownership proof for the official MCP Registry: it verifies this npm package by matching this field against `name` in server.json. Must stay io.github.<github-owner>/<server-name>.",
  "mcpName": "io.github.junxi25liu/oguri",
  "type": "module",
  "bin": {
    "oguri": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@oguri/core": "workspace:*",
    "@oguri/daemon": "workspace:*",
    "@oguri/intake": "workspace:*",
    "@oguri/mcp": "workspace:*",
    "@oguri/protocol": "workspace:*",
    "@oguri/superagent": "workspace:*",
    "@oguri/worker": "workspace:*"
  },
  "author": "Alexander (https://github.com/junxi25liu)",
  "homepage": "https://github.com/junxi25liu/oguri#readme",
  "bugs": {
    "url": "https://github.com/junxi25liu/oguri/issues"
  },
  "keywords": [
    "agents",
    "ai",
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "git",
    "mcp",
    "messaging",
    "model-context-protocol",
    "multi-agent",
    "orchestration",
    "superagent",
    "worker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junxi25liu/oguri.git",
    "directory": "packages/cli"
  }
}
