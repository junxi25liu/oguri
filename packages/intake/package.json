{
  "name": "@oguri/intake",
  "version": "1.0.1",
  "description": "oguri intake: turns a team chat's requests into tasks and sends acknowledgements, questions, and results back to the thread they came from.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@oguri/core": "workspace:*",
    "@oguri/daemon": "workspace:*",
    "@oguri/protocol": "workspace:*"
  },
  "author": "Alexander (https://github.com/junxi25liu)",
  "homepage": "https://github.com/junxi25liu/oguri#readme",
  "bugs": {
    "url": "https://github.com/junxi25liu/oguri/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "git",
    "feishu",
    "lark",
    "intake"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junxi25liu/oguri.git",
    "directory": "packages/intake"
  },
  "publishConfig": {
    "access": "public"
  }
}
