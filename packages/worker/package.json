{
  "name": "@oguri/worker",
  "version": "1.0.5",
  "description": "oguri worker: claims tasks addressed to this agent or machine, runs an allow-listed command, and reports the result.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@oguri/core": "workspace:*",
    "@oguri/daemon": "workspace:*",
    "@oguri/protocol": "workspace:*"
  },
  "author": "Alexander (https://github.com/junxi25liu)",
  "homepage": "https://github.com/junxi25liu/oguri#readme",
  "bugs": {
    "url": "https://github.com/junxi25liu/oguri/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "git",
    "worker",
    "claude",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junxi25liu/oguri.git",
    "directory": "packages/worker"
  },
  "publishConfig": {
    "access": "public"
  }
}
